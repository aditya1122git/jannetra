# Live monitoring is the secure default.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=jannetra
# Public host port used by the frontend container. Use 80 for direct HTTP
# when no other VPS service occupies port 80; otherwise keep 8080.
PUBLIC_PORT=8080
# Required for live mode. Generate independent random secrets; see README.
JWT_SECRET=
ENCRYPTION_KEY=
# First startup only. Remove both after the administrator exists in MongoDB.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Local inference; public model downloads need no API key.
HF_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HF_REVISION=f2f1202b1bdeb07342385c3f807f9c07cd8f5cf8
HF_TOKEN=
HF_CACHE_DIR=.cache/huggingface
HF_DEVICE=cpu
HF_BATCH_SIZE=16
HF_MAX_LENGTH=256
HF_CPU_THREADS=2
# Enable only after downloading the model into the cache.
HF_LOCAL_FILES_ONLY=false
YOUTUBE_API_KEY=
YOUTUBE_BACKUP_API_KEY=
YOUTUBE_INITIAL_LOOKBACK_DAYS=7
# One token connects Facebook, Instagram, X and Reddit through Apify Actors.
APIFY_API_TOKEN=
# Both values enable one Telegram alert for every newly classified negative post.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORTING_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
YOUTUBE_SYNC_INTERVAL_MINUTES=15
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Gemini verifies every HF-negative result, plus results below 80%.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HF_CONFIDENCE_THRESHOLD=0.80
GEMINI_CONCURRENCY=2
ENABLED_PLATFORMS=facebook,instagram,x,youtube,news,reddit
